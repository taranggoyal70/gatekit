# Required. Create a Clerk application at https://dashboard.clerk.com and
# copy its API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Required. Postgres connection string (e.g. from https://neon.tech or
# https://supabase.com). Run `pnpm db:migrate` after setting this.
DATABASE_URL=

# Optional. Enables approval-request emails. Create a key at
# https://resend.com/api-keys. Without it, approvals still work — the
# dashboard just won't be the only way anyone finds out about them.
RESEND_API_KEY=
GATEKIT_NOTIFICATION_FROM="Gatekit <notifications@yourdomain.com>"

# Public site URL, used in email links and OAuth-style redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
