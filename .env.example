# Copy to .env.local and fill in. Never commit real values: .env* is gitignored.

# --- Required to run the app -------------------------------------------------

# Clerk handles dashboard sign-in for humans. Create an application at
# https://dashboard.clerk.com and copy its API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Postgres connection string (Neon, Supabase, RDS or local). Run
# `pnpm db:migrate` after setting it.
DATABASE_URL=

# Public base URL, used in approval emails, Slack messages and billing
# redirects (falls back to http://localhost:3000). For canonical and Open Graph
# URLs only, Vercel's VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL are used when
# this is unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: approval and invite email (Resend) ----------------------------
# Without a key, approvals still work; nobody is emailed about them.
RESEND_API_KEY=
GATEKIT_NOTIFICATION_FROM="Gatekit <notifications@yourdomain.com>"

# --- Optional: Pro plan billing (Stripe) -------------------------------------
# Create a product/price, then a webhook endpoint pointed at
# https://your-domain.com/api/billing/webhook with the events
# checkout.session.completed, customer.subscription.updated and
# customer.subscription.deleted. Without them the dashboard shows a contact
# link instead of the upgrade button, /api/billing/checkout returns 503, and
# the webhook rejects every request.
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Slack ---------------------------------------------------------------------
# No environment variable. Each organization sets its own incoming-webhook URL
# in Settings -> Notifications (restricted to https://hooks.slack.com/services/).

# --- Tests ---------------------------------------------------------------------
# Optional. When set, integration tests run against this Postgres (migrate it
# first). When unset they run on in-process PGlite, so no database is needed.
TEST_DATABASE_URL=

# --- SDK examples ------------------------------------------------------------
# The agent key your own agent process uses with @gatekit/sdk. Create one in
# the dashboard under Agents; it is shown once. The app itself never reads it.
GATEKIT_KEY=
