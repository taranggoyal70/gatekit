{
  "name": "@gatekithq/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for Gatekit: policy gates, human approvals and a tamper-evident audit log for AI agent actions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taranggoyal70/gatekit.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/taranggoyal70/gatekit#readme",
  "keywords": [
    "ai-agents",
    "governance",
    "approvals",
    "audit-log",
    "policy"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
